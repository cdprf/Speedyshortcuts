{
  "name": "nice-speed-dials-extension",
  "version": "5.0.0",
  "license": "MIT",
  "keywords": [
    "browser",
    "extension",
    "speed dials",
    "solid",
    "solidjs"
  ],
  "author": {
    "name": "Krushang Kasundra",
    "url": "https://kruz.me"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kruzkasu223/nice-speed-dials-extension"
  },
  "description": "Nice and Simple Speed Dials Extension for Browser",
  "type": "module",
  "scripts": {
    "prepare": "panda codegen && wxt prepare",
    "dev": "wxt --mv3",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build --mv3",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip --mv3 && cp .output/extension-chrome.zip extension-chrome.zip",
    "zip:firefox": "wxt zip -b firefox --mv3 && cp .output/extension-firefox.zip extension-firefox.zip",
    "zip:edge": "wxt zip -b edge --mv3 && cp .output/extension-edge.zip extension-edge.zip",
    "zip:all": "wxt zip --mv3 && wxt zip -b firefox --mv3 && wxt zip -b edge --mv3 && cp .output/extension-chrome.zip extension-chrome.zip && cp .output/extension-firefox.zip extension-firefox.zip && cp .output/extension-edge.zip extension-edge.zip",
    "parkui:add": "park-ui add",
    "parkui:update": "park-ui add button alert dialog drawer icon-button input menu text tooltip switch slider color-picker file-upload number-input",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@pandacss/dev": "1.12.0",
    "@park-ui/cli": "1.0.1",
    "@park-ui/panda-preset": "0.43.1",
    "@types/chrome": "0.2.7",
    "@wxt-dev/module-solid": "1.1.4",
    "prettier": "3.9.6",
    "sass-embedded": "1.103.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-solid": "2.11.14",
    "wxt": "0.21.4"
  },
  "dependencies": {
    "@ark-ui/solid": "5.39.0",
    "caniuse-lite": "1.0.30001809",
    "lucide-solid": "1.33.0",
    "solid-dnd-directive": "0.2.0",
    "solid-js": "1.9.15"
  }
}
